# ==============================
# 基础配置
# ==============================
# Compose 项目名，会影响容器名前缀和默认网络名。
COMPOSE_PROJECT_NAME=robot-mediaserver
# Java 服务镜像名前缀，例如 robot/media-service:latest。
IMAGE_PREFIX=robot
# Java 服务镜像 tag。
IMAGE_TAG=latest
# Java 服务 Docker 镜像使用的运行时基础镜像。必须包含 Java 17、ffmpeg、ffprobe，用于 HLS 切片和视频信息探测。
JAVA_RUNTIME_IMAGE=robot/java17-ffmpeg-runtime:latest
# 目标服务器 CPU 架构：amd64 或 arm64。
TARGET_ARCH=amd64
# Docker 平台值。amd64 对应 linux/amd64，arm64 对应 linux/arm64。
TARGET_PLATFORM=linux/amd64
# 容器时区。
TZ=Asia/Shanghai
# Compose 网络名。
DOCKER_NETWORK=robot-mediaserver
# 部署网络模式：bridge 为默认 Docker bridge；host 不创建 Docker bridge，适合 OpenStack 等对 Docker 路由敏感的 Linux 服务器。host 模式仅建议 Linux 服务器使用。
DEPLOY_NETWORK_MODE=bridge
# Compose bridge 子网。必须选择一个不在服务器 ip route/内网/VPN 中出现的网段，避免 Docker 路由抢占服务器网络。
DOCKER_NETWORK_SUBNET=10.253.10.0/24
# 服务器宿主机运行目录，Java 包、配置、Nginx 静态资源都会安装到这里。
APP_WORKSPACE_ROOT=/home/jszn/mounts/media
# 安装模式：skip_existing 表示已存在文件/目录不覆盖；overwrite 表示覆盖升级。
INSTALL_MODE=skip_existing
# 地图安装模式：默认 skip_existing。即使 INSTALL_MODE=overwrite，已有 nginx/html/tdt 也会跳过；需要强制刷新地图时改为 overwrite。
TDT_INSTALL_MODE=skip_existing

# ==============================
# 服务端口
# ==============================
# 媒体服务对外端口。
MEDIA_SERVICE_PORT=8088
# 控制服务对外端口。
CONTROL_SERVICE_PORT=8082
# 大屏 BFF 对外端口。
BIGSCREEN_BFF_PORT=8090
# 是否开启 Java 远程调试。生产环境建议保持 false。
JAVA_DEBUG_ENABLED=false
# 媒体服务 Java 调试宿主机端口。
MEDIA_SERVICE_DEBUG_PORT=5005
# 控制服务 Java 调试宿主机端口。
CONTROL_SERVICE_DEBUG_PORT=5006
# 大屏 BFF Java 调试宿主机端口。
BIGSCREEN_BFF_DEBUG_PORT=5007
# Media Service 启用的 Spring Profile；当前默认使用 dev。
SPRING_PROFILES_ACTIVE=dev
# Media Service 容器内 HTTP 监听端口；修改时需同步内部服务地址和 Nginx upstream。
SERVER_PORT=8088
# Control Service 容器内 HTTP 监听端口；修改时需同步内部服务地址和 Nginx upstream。
CONTROL_SERVER_PORT=8082

# ==============================
# Nginx 配置
# ==============================
# Nginx 镜像名，需要提前放入 tool-images/<arch>。
NGINX_IMAGE=nginx:alpine
# Nginx HTTP 端口。
NGINX_HTTP_PORT=80
# Nginx 测试/备用 HTTP 端口。
NGINX_ALT_HTTP_PORT=280
# Nginx HTTPS 端口。
NGINX_HTTPS_PORT=4443
# Nginx 测试/备用 HTTPS 端口。
NGINX_ALT_HTTPS_PORT=24443
# 生成自签证书时使用的 IP 或域名。
NGINX_TLS_HOST=localhost
# Nginx 反向代理媒体服务的上游地址，格式 host:port。
NGINX_MEDIA_SERVICE_UPSTREAM=host.docker.internal:8088
# Nginx 反向代理大屏 BFF 的上游地址，格式 host:port。
NGINX_BIGSCREEN_BFF_UPSTREAM=host.docker.internal:8090
# Nginx 反向代理 LiveKit 的上游地址，格式 host:port。
NGINX_LIVEKIT_UPSTREAM=host.docker.internal:7880
# Nginx 反向代理管理端 API 网关的上游地址，格式 host:port。
NGINX_API_GATEWAY_UPSTREAM=host.docker.internal:8080
# Nginx 测试/备用媒体服务上游地址。
NGINX_MEDIA_SERVICE_TEST_UPSTREAM=host.docker.internal:28088
# Nginx 测试/备用大屏 BFF 上游地址。
NGINX_BIGSCREEN_BFF_TEST_UPSTREAM=host.docker.internal:28090
# Nginx 测试/备用 LiveKit 上游地址。
NGINX_LIVEKIT_TEST_UPSTREAM=host.docker.internal:7880

# ==============================
# TTS 容器配置
# ==============================
# TTS 镜像名，需要提前放入 tool-images/<arch>。
TTS_IMAGE=local/sherpa-tts-http:zh-en
# TTS 服务宿主机端口，容器内端口固定为 8080。
TTS_PORT=5050
# TTS 容器与 Media Service 的音频生成、缓存目录。
TTS_OUTPUT_ROOT=/data/tts
# 单次 TTS 请求最大文本长度。
TTS_MAX_TEXT_LENGTH=1000
# 媒体服务调用 TTS 引擎的地址。Compose 内推荐使用 http://tts:8080/api/tts。
TTS_ENGINE_URL=http://tts:8080/api/tts
# 可选 Compose profile，多个值用逗号分隔。中心服务器默认留空；TTS 使用 tts，
# 仅在可访问现场 RTSP 的边缘节点启用 fixed-camera-gateway。
COMPOSE_PROFILES=
# 是否将 TTS 镜像和 app.py 配置打包进安装包。暂时不使用 TTS 时保持 false。
PACKAGE_TTS=false

# ==============================
# MySQL / Redis / Elasticsearch
# ==============================
# MySQL JDBC 连接地址。createDatabaseIfNotExist=true 用于首次部署时自动创建 robot_media 数据库，前提是账号有建库权限。
MYSQL_URL=jdbc:mysql://host.docker.internal:3307/robot_media?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# MySQL 用户名。
MYSQL_USERNAME=root
# MySQL 密码。
MYSQL_PASSWORD=root
# Redis 主机地址。
REDIS_HOST=host.docker.internal
# Redis 端口。
REDIS_PORT=6380
# Elasticsearch 地址，多个地址按 Spring Boot 支持的格式填写。
ELASTICSEARCH_URIS=http://host.docker.internal:9200

# ==============================
# LiveKit 配置
# ==============================
# 返回给浏览器和机器人客户端的 LiveKit 外部访问地址，应使用外部可访问的 IP 或域名。
LIVEKIT_URL=ws://host.docker.internal:7880
# 媒体服务调用 LiveKit Room/Egress API 的内部地址；LiveKit 使用宿主机网络，bridge 容器需通过宿主机地址访问。
LIVEKIT_INTERNAL_URL=ws://host.docker.internal:7880
# LiveKit API Key。
LIVEKIT_API_KEY=devkey
# LiveKit API Secret，生产环境必须替换。
LIVEKIT_API_SECRET=dev-secret-dev-secret-dev-secret-32
# LiveKit 回调 Media 的内部地址；LiveKit 使用宿主机网络，通过 Media 的宿主机端口回调。
LIVEKIT_WEBHOOK_URL=http://host.docker.internal:8088/internal/media/livekit/webhook
# Webhook 漏投时 Media 主动核对 Publisher/Track 的周期，单位毫秒。
LIVEKIT_RECONCILE_DELAY_MS=5000
# 普通视频会话 LiveKit Token 有效期，单位秒。
LIVEKIT_TOKEN_TTL_SECONDS=600
# 现场 App 视频通话 LiveKit Token 有效期，单位秒。
LIVEKIT_FIELD_CALL_TOKEN_TTL_SECONDS=7200
# 是否启用 LiveKit Room 管理 API。
LIVEKIT_ROOM_API_ENABLED=true
# 是否启用 LiveKit Egress 录像能力。
LIVEKIT_EGRESS_ENABLED=true
# 是否启用固定摄像头 RTMP Ingress 管理能力；Java 业务实现上线前保持 false。
LIVEKIT_INGRESS_ENABLED=false
# Ingress/Track 状态超过该秒数未更新时视为陈旧。
LIVEKIT_INGRESS_STATUS_STALE_SECONDS=15
# 单次 LiveKit Ingress HTTP 调用超时，单位毫秒。
LIVEKIT_INGRESS_CALL_TIMEOUT_MS=3000
# 单次 Ingress 管理操作总预算，单位毫秒。
LIVEKIT_INGRESS_OPERATION_TIMEOUT_MS=5000
# 获取 Ingress 管理并发许可的最长等待时间，单位毫秒。
LIVEKIT_INGRESS_PERMIT_WAIT_MS=200
# 单个 Media 实例的 Ingress 管理并发数；默认 2 要求 Hikari 连接池至少为 8。
LIVEKIT_INGRESS_MAX_CONCURRENCY=2
# LiveKit Egress HLS 分片时长，单位秒。
LIVEKIT_EGRESS_SEGMENT_DURATION_SECONDS=6
# LiveKit Egress 写入 S3/MinIO 时使用的区域。
LIVEKIT_EGRESS_S3_REGION=us-east-1
# LiveKit Egress 是否使用 S3 path-style 访问。
LIVEKIT_EGRESS_S3_FORCE_PATH_STYLE=true
# LiveKit Room 空房后的自动清理等待时间，单位秒。
LIVEKIT_ROOM_EMPTY_TIMEOUT_SECONDS=60
# LiveKit 参与者离开后的保留等待时间，单位秒。
LIVEKIT_ROOM_DEPARTURE_TIMEOUT_SECONDS=20
# 最后一个观看者离开后保留视频会话的时间，单位秒；Media 和 Control 必须使用同一值。
IDLE_RELEASE_DELAY_SECONDS=30
# LiveKit Server 镜像名，需要提前放入 tool-images/<arch>。
# 官方 index digest: sha256:483b8b7b5b0654f91f1e8bdc7b46fcd37fd9911612ecf627f97e3185a89825bd
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13.3
# LiveKit Ingress 镜像名，需要提前放入 tool-images/<arch>。
# 官方 index digest: sha256:2e1d3fcf10bfaebddaea74dc8b965410cda6377ed154451361b86ab3a9ee9f99
LIVEKIT_INGRESS_IMAGE=livekit/ingress:v1.5.0
# LiveKit Egress 镜像名，需要提前放入 tool-images/<arch>。
# 官方 index digest: sha256:980ff439431df2c773573721ab6da19e15bdc1f049ab7cb80e87470bf174c12f
LIVEKIT_EGRESS_IMAGE=livekit/egress:v1.13.0
# LiveKit HTTP/API 端口。
LIVEKIT_HTTP_PORT=7880
# LiveKit RTC TCP 端口。
LIVEKIT_RTC_TCP_PORT=7881
# LiveKit RTC UDP 端口范围起始值。
LIVEKIT_RTC_PORT_RANGE_START=50000
# LiveKit RTC UDP 端口范围结束值。
LIVEKIT_RTC_PORT_RANGE_END=60000
# 是否通过 STUN 自动发现并公告外部 IP。云端一对一 NAT 且公网 IP 固定时建议设为 false，
# 并将 LIVEKIT_NODE_IP 配置为公网 IP；设为 true 时必须留空 LIVEKIT_NODE_IP。
LIVEKIT_USE_EXTERNAL_IP=false
# LiveKit 日志级别。
LIVEKIT_LOG_LEVEL=info
# LiveKit Server 使用的 Redis 地址，格式 host:port。
LIVEKIT_REDIS_ADDRESS=host.docker.internal:6380
# LiveKit Server 使用的 Redis 用户名，可为空。
LIVEKIT_REDIS_USERNAME=
# LiveKit Server 使用的 Redis 密码，可为空。
LIVEKIT_REDIS_PASSWORD=
# LiveKit Server 使用的 Redis DB。
LIVEKIT_REDIS_DB=1
# LiveKit 对客户端公告的节点 IP。公网一对一 NAT 填公网 IP；私有化内网部署填客户端可达的内网 IP。
# 仅在 LIVEKIT_USE_EXTERNAL_IP=false 时生效。
LIVEKIT_NODE_IP=
# CreateIngress 返回给摄像头的 RTMP 地址前缀，必须是摄像头可访问的公网 IP、域名或私有化部署地址。
LIVEKIT_INGRESS_RTMP_BASE_URL=rtmp://127.0.0.1:1935/live
# Ingress Worker 连接 LiveKit Server 的内部地址。
LIVEKIT_INGRESS_WS_URL=ws://127.0.0.1:7880
# LiveKit Egress 连接 LiveKit Server 的 WebSocket 地址。
LIVEKIT_EGRESS_WS_URL=ws://host.docker.internal:7880
# LiveKit Egress 使用的 Redis 地址，格式 host:port。
LIVEKIT_EGRESS_REDIS_ADDRESS=host.docker.internal:6380
# LiveKit Egress 使用的 Redis 用户名，可为空。
LIVEKIT_EGRESS_REDIS_USERNAME=
# LiveKit Egress 使用的 Redis 密码，可为空。
LIVEKIT_EGRESS_REDIS_PASSWORD=
# LiveKit Egress 使用的 Redis DB。
LIVEKIT_EGRESS_REDIS_DB=1

# ==============================
# MinIO / S3 配置
# ==============================
# Media、HLS、Egress 等服务端程序访问 MinIO/S3 的内部地址。
# 公网 IP 不支持 NAT 回环时，这里必须配置内网 IP，避免服务器访问自身公网 IP 超时。
MINIO_ENDPOINT=http://host.docker.internal:9000
# 预签名上传/下载 URL 下发给浏览器或机器人的外部地址；为空时沿用 MINIO_ENDPOINT。
# 服务器部署建议执行 configure-env-ip.sh 自动设置为公网 IP 或外部可访问域名。
# 注意：服务器自身若无法访问该地址（NAT 不回环），必须保证 MINIO_REGION 与
# MinIO 服务端一致——显式 region 让预签名纯本地计算，不再向该地址探测。
MINIO_PUBLIC_ENDPOINT=
# 预签名下载 URL 使用的 HTTPS 出口（如经 nginx /robot-media/ 反代的地址）；
# 页面为 HTTPS 时下载地址必须是 HTTPS，否则浏览器 Mixed Content 拦截；为空时沿用 MINIO_PUBLIC_ENDPOINT。
MINIO_DOWNLOAD_PUBLIC_ENDPOINT=
# MinIO/S3 的 region 声明，需与服务端 MINIO_REGION_NAME 一致。
MINIO_REGION=us-east-1
# MinIO/S3 Access Key。
MINIO_ACCESS_KEY=eiopminio
# MinIO/S3 Secret Key。
MINIO_SECRET_KEY=eiopminio123
# 媒体文件桶名。
MINIO_BUCKET=robot-media
# 是否启用 Media Service 的 MinIO/S3 对象存储能力。
MINIO_ENABLED=true

# ==============================
# 文件上传会话配置
# ==============================
# 单机器人未过期 ACTIVE 上传会话容量，不代表客户端实际 PUT 并发数。
MEDIA_FILE_MAX_ACTIVE_UPLOADS_PER_ROBOT=100
# 全局未过期 ACTIVE 上传会话容量。
MEDIA_FILE_MAX_ACTIVE_UPLOADS_GLOBAL=5000
# 过期上传会话清理周期，单位毫秒；每轮最多处理 100 条。
MEDIA_FILE_CLEANUP_DELAY_MS=60000
# 是否启用媒体文件上传、播放和转码能力。
MEDIA_FILE_ENABLED=true
# 普通 multipart 简单上传允许的最大文件大小，单位字节。
MEDIA_FILE_SIMPLE_UPLOAD_MAX_BYTES=20971520
# 单个媒体文件允许的最大大小，单位字节。
MEDIA_FILE_MAX_FILE_SIZE_BYTES=51539607552
# 分片上传的单片大小，单位字节。
MEDIA_FILE_PART_SIZE_BYTES=5242880
# 分片上传预签名 URL 的有效期，单位秒。
MEDIA_FILE_UPLOAD_URL_TTL_SECONDS=604800
# 未完成分片上传会话的过期时间，单位小时。
MEDIA_FILE_MULTIPART_EXPIRE_HOURS=720
# 单次请求最多返回的分片上传 URL 数量。
MEDIA_FILE_MAX_PART_URLS_PER_REQUEST=16
# 初始化分片上传时默认预签发的分片 URL 数量。
MEDIA_FILE_INITIAL_PART_URL_COUNT=16
# 媒体播放 URL 的有效期，单位秒。
MEDIA_FILE_PLAY_URL_TTL_SECONDS=3600
# 媒体播放 Token 的签名密钥；生产环境必须替换。
MEDIA_FILE_PLAY_TOKEN_SECRET=file-playback-development-secret-change-me
# HLS 转码使用的 ffmpeg 可执行文件路径。
MEDIA_FILE_HLS_FFMPEG_PATH=ffmpeg
# 媒体信息探测使用的 ffprobe 可执行文件路径。
MEDIA_FILE_FFPROBE_PATH=ffprobe
# 通用 ffmpeg 可执行文件路径，作为专项配置的回退值。
FFMPEG_PATH=ffmpeg
# 通用 ffprobe 可执行文件路径，作为专项配置的回退值。
FFPROBE_PATH=ffprobe
# HLS 转码分片时长，单位秒。
MEDIA_FILE_HLS_SEGMENT_DURATION_SECONDS=6
# HLS 转码工作线程并发数。
MEDIA_FILE_HLS_WORKER_CONCURRENCY=2
# HLS 转码任务处理租约时长，单位秒。
MEDIA_FILE_HLS_PROCESSING_LEASE_SECONDS=300
# 媒体文件默认保留天数。
MEDIA_FILE_RETENTION_DAYS=30
# 是否允许受信任机器人网络绕过普通上传身份校验。
MEDIA_FILE_TRUSTED_ROBOT_NETWORK_ENABLED=false
# 受信任机器人网络 CIDR，多个值用逗号分隔。
MEDIA_FILE_TRUSTED_ROBOT_CIDRS=127.0.0.1/32,::1/128
# 无法从请求解析组织时使用的默认组织 ID。
MEDIA_FILE_DEFAULT_ORG_ID=org001
# 是否启用 Media Service 的 TTS 能力；未启动 TTS 服务时应设为 false。
TTS_ENABLED=true
# TTS 默认声音或模型标识。
TTS_VOICE=coqui-tts:zh_baker
# TTS 输出音频格式。
TTS_FORMAT=wav
# Media Service 连接 TTS 引擎的超时时间，单位毫秒。
TTS_CONNECT_TIMEOUT_MS=5000
# Media Service 读取 TTS 响应的超时时间，单位毫秒。
TTS_READ_TIMEOUT_MS=30000
# 等待同一文本 TTS 生成锁的最长时间，单位秒。
TTS_GENERATE_LOCK_TIMEOUT_SECONDS=30
# WAV 音频数据起始偏移字节数。
TTS_WAV_HEADER_OFFSET=44
# 视频会话等待 Publisher 发布 Track 的超时时间，单位秒。
TRACK_PUBLISH_TIMEOUT_SECONDS=20
# 视频会话中断后进入恢复流程前的宽限时间，单位秒。
INTERRUPTED_GRACE_SECONDS=15
# 观看者心跳超时时间，单位秒。
VIEWER_HEARTBEAT_TIMEOUT_SECONDS=15
# 多 Media 实例间视频周期任务的执行租约时间，单位秒。
VIDEO_SCHEDULER_LEASE_SECONDS=30

# ==============================
# 控制服务缓存与认证
# ==============================
# 控制服务管理端设备档案/设备列表/类型字典缓存 TTL（秒），生产默认 120 秒，
# 兼顾权限变更生效速度与管理端请求压力。
MANAGEMENT_DEVICE_CACHE_TTL_SECONDS=120
# 控制服务过期缓存清理周期（毫秒），默认 60000。
CONTROL_DEVICE_CACHE_EVICT_DELAY_MS=60000
# 是否允许控制服务在缺少可信身份头（X-User-Id/X-Roles 等）时回退到开发默认用户。
# 生产环境必须由 BFF/API 网关注入可信身份头，应保持 false；本地直连调试可临时设为 true。
CONTROL_AUTH_ALLOW_DEFAULT_USER=false
# Control Service 缺少组织上下文时使用的默认组织 ID。
CONTROL_DEFAULT_ORG_ID=org001
# Control 访问 Media Service 的内部地址。
MEDIA_SERVICE_BASE_URL=http://media-service:8088

# ==============================
# MQTT 配置
# ==============================
# 是否启用 MQTT。
MQTT_ENABLED=true
# MQTT Broker 地址。
MQTT_BROKER_URL=tcp://host.docker.internal:1884
# MQTT 用户名，可为空。
MQTT_USERNAME=
# MQTT 密码，可为空。
MQTT_PASSWORD=
# 控制服务连接 MQTT 时使用的客户端 ID。
MQTT_CLIENT_ID=robot-control-service-main
# 里程增量允许的最大平均速度，超过该值的跳变不计入统计，单位 m/s。
MILEAGE_MAX_SPEED_MPS=15
# 累计新增里程达到该阈值后通知 BFF 刷新统计，单位米。
MILEAGE_PUBLISH_DISTANCE_THRESHOLD_METERS=10
# 机器人心跳超时时间，单位秒。
ROBOT_HEARTBEAT_TIMEOUT_SECONDS=30
# 机器人心跳扫描任务间隔，单位毫秒。
ROBOT_HEARTBEAT_SWEEP_DELAY_MS=1000
# 离线注册表条目保留时间，单位秒；超过该时长未再上报的离线设备从注册表中清理。
ROBOT_OFFLINE_RETENTION_SECONDS=60
# 是否通过同事 Control 的 STOMP WebSocket 接收任务变更通知。
CENTER_STOMP_ENABLED=true
# 同事 Control 的服务间 STOMP 端点，不能指向本服务的 /ws/control。
CENTER_STOMP_WS_URL=ws://host.docker.internal:8867/ws/control
# 同事 Control 发布平台实时事件的 STOMP Topic。
CENTER_STOMP_TOPIC=/topic/platform/realtime-events
# 临时调试可直接配置 token；生产建议留空并使用下面的 client_credentials 配置。
CENTER_STOMP_ACCESS_TOKEN=
# 使用 client_credentials 获取 STOMP Access Token 的 OAuth2 Token 地址。
CENTER_STOMP_TOKEN_URL=
# STOMP 桥接服务申请 Access Token 使用的 OAuth2 Client ID。
CENTER_STOMP_CLIENT_ID=
# STOMP 桥接服务申请 Access Token 使用的 OAuth2 Client Secret。
CENTER_STOMP_CLIENT_SECRET=
# STOMP 连接断开后的重连等待时间，单位毫秒。
CENTER_STOMP_RECONNECT_DELAY_MS=5000
# 固定摄像头 Gateway 实例 ID，必须与 Control Service 下发 topic 使用的 gatewayId 一致。
FIXED_CAMERA_GATEWAY_ID=default
# 固定摄像头 Gateway 的 MQTT clientId。
FIXED_CAMERA_CLIENT_ID=fixed-camera-gateway
# Gateway 内部观测监听地址，仅提供 /health 和 /metrics；留空时普通 Compose 使用 :9091，host 网络使用 127.0.0.1:9091。
FIXED_CAMERA_HTTP_ADDR=
# Gateway 心跳、健康探测与 Control 侧超时判定。
FIXED_CAMERA_HEARTBEAT_INTERVAL_SECONDS=10
# Gateway 主动探测固定摄像头健康状态的周期，单位秒。
FIXED_CAMERA_HEALTH_PROBE_INTERVAL_SECONDS=60
# Gateway 同时执行固定摄像头健康探测的最大并发数。
FIXED_CAMERA_HEALTH_PROBE_CONCURRENCY=4
# Control 判定固定摄像头 Gateway 离线的超时时间，单位秒。
FIXED_CAMERA_GATEWAY_TIMEOUT_SECONDS=30
# Control 接受固定摄像头最近健康状态的最大年龄，单位秒。
FIXED_CAMERA_HEALTH_MAX_AGE_SECONDS=120
# Control 清理过期 Gateway 和摄像头健康状态的扫描周期，单位毫秒。
FIXED_CAMERA_HEALTH_SWEEP_DELAY_MS=1000
# 固定摄像头短租约目录。
FIXED_CAMERA_CATALOG_MAX_LEASE_SECONDS=300
# Control 清理过期固定摄像头目录租约的扫描周期，单位毫秒。
FIXED_CAMERA_CATALOG_SWEEP_DELAY_MS=1000
# 允许向 Control 同步固定摄像头目录租约的可信调用方标识。
FIXED_CAMERA_CATALOG_TRUSTED_CALLER=bigscreen-bff
# publisher 正常停止宽限，超时后强制清理进程组，单位秒。
FIXED_CAMERA_PUBLISHER_STOP_TIMEOUT_SECONDS=5
# Gateway 使用的 ffprobe 可执行文件路径。
FIXED_CAMERA_FFPROBE_PATH=ffprobe
# Gateway 单次 RTSP 探测超时时间，单位毫秒。
FIXED_CAMERA_PROBE_TIMEOUT_MS=8000
# Gateway Publisher 模式：auto、gstreamer 或 ffmpeg。
FIXED_CAMERA_PUBLISHER_MODE=auto
# auto 模式启动 GStreamer 后等待其稳定运行的观察时间，单位秒；观察期内退出则回退 FFmpeg。
FIXED_CAMERA_PUBLISHER_FALLBACK_WATCH_SECONDS=8
# GStreamer 发布失败后再次尝试前的冷却时间，单位秒。
FIXED_CAMERA_PUBLISHER_GSTREAMER_RETRY_SECONDS=60
# 自定义 Publisher 命令；为空时按 Publisher 模式选择内置命令。
FIXED_CAMERA_PUBLISHER_CMD=
# FFmpeg Publisher 命令模板，占位符由 Gateway 在启动时替换。
FIXED_CAMERA_FFMPEG_PUBLISHER_CMD=./scripts/ffmpeg-livekit-publisher.sh {rtsp} {livekitUrl} {token}
# FFmpeg 转码 preset，用于必须转码的 RTSP 流。
FIXED_CAMERA_FFMPEG_TRANSCODE_PRESET=ultrafast
# GStreamer Publisher 可执行文件路径。
FIXED_CAMERA_GSTREAMER_PUBLISHER_PATH=gstreamer-publisher
# GStreamer RTSP 拉流管线模板，占位符由 Gateway 在启动时替换。
FIXED_CAMERA_GSTREAMER_PIPELINE=rtspsrc location={rtsp} protocols=tcp latency=100 drop-on-latency=true ! queue max-size-buffers=0 max-size-bytes=0 max-size-time=200000000 leaky=downstream ! rtph264depay ! h264parse config-interval=1 ! video/x-h264,alignment=au ! h264timestamper
# 禁用 GLib 系统代理解析，避免局域网 RTSP 被代理设置干扰。
FIXED_CAMERA_GIO_USE_PROXY_RESOLVER=dummy
# Java 服务结构化控制台日志格式。
LOGGING_STRUCTURED_FORMAT_CONSOLE=logstash
# ==============================
# 大屏 BFF / 中心服务配置
# ==============================
# 大屏前端使用的 Keycloak 公共 SPA Client ID。
BIGSCREEN_AUTH_CLIENT_ID=bigscreen-web
# 现场端公共 SPA Client ID。
FIELD_CALL_AUTH_CLIENT_ID=field-app
# Access Token 中必须匹配的 issuer。该值必须与 Keycloak 实际签发值完全一致。
BIGSCREEN_AUTH_ISSUER_URI=https://192.168.124.235:18443/realms/iam-auth
# BFF 获取验签公钥的服务间地址。使用 Keycloak 内部 HTTP 入口，避免自签 HTTPS 证书信任问题。
BIGSCREEN_AUTH_JWK_SET_URI=http://192.168.124.235:18080/realms/iam-auth/protocol/openid-connect/certs
# 大屏 BFF 统计历史报告过期清理周期（毫秒），默认 3600000（1 小时）。
STATISTICS_REPORT_CLEANUP_INTERVAL_MS=3600000
# 新报告写入后必须保留的最小磁盘余量，默认 1 GiB。
STATISTICS_REPORT_MINIMUM_FREE_BYTES=1073741824
# 报告索引使用本地持久化文件，只允许单实例运行。
STATISTICS_REPORT_INSTANCE_COUNT=1
# 大屏 BFF JVM 启动参数。
BIGSCREEN_BFF_JAVA_OPTS=-Xms512m -Xmx512m -XX:+ExitOnOutOfMemoryError -Duser.timezone=Asia/Shanghai
# 大屏 BFF 容器内存限制。
BIGSCREEN_BFF_MEMORY_LIMIT=1g
# WebSocket 初始化、授权快照最大陈旧窗口和会话容量限制。
BIGSCREEN_WS_AUTHORIZATION_MAX_STALENESS_MS=300000
# BFF WebSocket 建连时等待初始授权快照的最长时间，单位毫秒。
BIGSCREEN_WS_INITIALIZATION_WAIT_MS=15000
# 单一用户身份允许建立的最大 BFF WebSocket 会话数。
BIGSCREEN_WS_MAX_SESSIONS_PER_IDENTITY=8
# 单一组织允许建立的最大 BFF WebSocket 会话数。
BIGSCREEN_WS_MAX_SESSIONS_PER_ORGANIZATION=64
# 单个 BFF 实例允许建立的最大 WebSocket 会话数。
BIGSCREEN_WS_MAX_SESSIONS_PER_INSTANCE=64
# BFF 向 Control 同步固定摄像头短租约目录。
FIXED_CAMERA_CATALOG_LEASE_ENABLED=true
# BFF 为固定摄像头目录申请的单次租约时长，单位秒。
FIXED_CAMERA_CATALOG_LEASE_SECONDS=180
# Management 任务接口的连接超时时间，单位毫秒。
PANORAMA_TASK_CONNECT_TIMEOUT_MS=1000
# Management 任务接口的读取超时时间，单位毫秒。
PANORAMA_TASK_READ_TIMEOUT_MS=1500
# Management 任务接口请求的最大并发数。
PANORAMA_TASK_MAX_CONCURRENCY=8
# Management 通用资源接口的连接超时时间，单位毫秒。
PANORAMA_GENERAL_CONNECT_TIMEOUT_MS=1000
# Management 通用资源接口的读取超时时间，单位毫秒。
PANORAMA_GENERAL_READ_TIMEOUT_MS=1500
# Management 通用资源接口请求的最大并发数。
PANORAMA_GENERAL_MAX_CONCURRENCY=16
# 工作流可处置告警接口的连接超时时间，单位毫秒。
PANORAMA_WORKFLOW_ALARM_CONNECT_TIMEOUT_MS=1000
# 工作流可处置告警接口的读取超时时间，单位毫秒。
PANORAMA_WORKFLOW_ALARM_READ_TIMEOUT_MS=5000
# 工作流可处置告警解析的最大并发数。
PANORAMA_WORKFLOW_ALARM_MAX_CONCURRENCY=4
# 控制服务和大屏 BFF 访问管理中心的基础地址。
CENTER_MANAGE_BASE_URL=http://host.docker.internal:8866
# 通用文件经过 Control Service 上传时的请求大小限制。
CONTROL_FILE_UPLOAD_MAX_FILE_SIZE=20MB
# 通用文件经过 Control Service 上传时的 multipart 请求总大小限制。
CONTROL_FILE_UPLOAD_MAX_REQUEST_SIZE=21MB
# 通用文件经过大屏 BFF 上传时的单文件大小限制。
BIGSCREEN_MULTIPART_MAX_FILE_SIZE=20MB
# 通用文件经过大屏 BFF 上传时的 multipart 请求总大小限制。
BIGSCREEN_MULTIPART_MAX_REQUEST_SIZE=21MB
# 单次手动录像最长持续时间，单位秒；小于等于 0 时不限制。
MEDIA_FILE_LIVE_RECORDING_MAX_DURATION_SECONDS=14400
# 控制服务基础地址。Compose 内推荐使用 http://control-service:8082。
CENTER_CONTROL_BASE_URL=http://control-service:8082
# 旧版控制服务基础地址。
CENTER_V1_CONTROL_BASE_URL=http://host.docker.internal:8867
# 媒体服务基础地址。Compose 内推荐使用 http://media-service:8088。
CENTER_MEDIA_BASE_URL=http://media-service:8088
# 控制服务 WebSocket 地址。
CENTER_CONTROL_WS_URL=ws://control-service:8082/ws/control
# 现场 App 视频呼叫使用的 Control Service WebSocket 地址。
CENTER_FIELD_CALL_WS_URL=ws://control-service:8082/ws/field-call
# 大屏接口允许跨域访问的来源模式，多个值用逗号分隔。
BIGSCREEN_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.*.*:8080,https://192.168.*.*:4443
# BFF 检查 WebSocket Token 和授权快照有效性的周期，单位毫秒。
BIGSCREEN_WS_AUTHORIZATION_CHECK_INTERVAL_MS=1000
# BFF 单次加载完整 WebSocket 授权快照的总超时时间，单位毫秒。
BIGSCREEN_WS_AUTHORIZATION_LOAD_TIMEOUT_MS=8000
# 大屏统计报告在容器内的持久化目录。
STATISTICS_REPORT_STORAGE_DIR=/data/statistics-reports
