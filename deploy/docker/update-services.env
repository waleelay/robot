# 增量更新时需保证的服务器环境变量（SERVICE VAR=VALUE 格式，每行一个）
# 用法：sh deploy/docker/update-services.sh 会读取本文件，把以下变量同步到服务器 .env
#       并接线到 docker-compose.yml 对应服务的 environment 段（已有则改值，缺失则追加，幂等）。
# 每次发布按实际新增/调整的环境变量增删行；无需改动的变量不必保留。

# ---------- 媒体服务 ----------
# 单次手动录像最长持续时间（秒），小于等于 0 时不限制。
media-service MEDIA_FILE_LIVE_RECORDING_MAX_DURATION_SECONDS=14400

# ---------- 控制服务 ----------
# 管理端设备档案/设备列表/类型字典缓存 TTL（秒）。
control-service MANAGEMENT_DEVICE_CACHE_TTL_SECONDS=30
# 过期缓存清理周期（毫秒）。
control-service CONTROL_DEVICE_CACHE_EVICT_DELAY_MS=60000
# 缺少可信身份头时是否回退开发默认用户；生产由 BFF 注入可信身份头，保持 false。
control-service CONTROL_AUTH_ALLOW_DEFAULT_USER=false
# 机器人心跳超时时间（秒）。
control-service ROBOT_HEARTBEAT_TIMEOUT_SECONDS=30
# 机器人心跳扫描任务间隔（毫秒）。
control-service ROBOT_HEARTBEAT_SWEEP_DELAY_MS=1000
control-service FIXED_CAMERA_GATEWAY_TIMEOUT_SECONDS=30
control-service FIXED_CAMERA_HEALTH_MAX_AGE_SECONDS=120
control-service FIXED_CAMERA_HEALTH_SWEEP_DELAY_MS=1000
control-service FIXED_CAMERA_CATALOG_MAX_LEASE_SECONDS=300
control-service FIXED_CAMERA_CATALOG_SWEEP_DELAY_MS=1000
control-service FIXED_CAMERA_CATALOG_TRUSTED_CALLER=bigscreen-bff

# ---------- 固定摄像头 Gateway ----------
fixed-camera-gateway FIXED_CAMERA_HEARTBEAT_INTERVAL_SECONDS=10
fixed-camera-gateway FIXED_CAMERA_HEALTH_PROBE_INTERVAL_SECONDS=60
fixed-camera-gateway FIXED_CAMERA_HEALTH_PROBE_CONCURRENCY=4
fixed-camera-gateway FIXED_CAMERA_CATALOG_MODE=lease

# ---------- 大屏 BFF ----------
# 统计历史报告过期清理周期（毫秒）。
bigscreen-bff STATISTICS_REPORT_CLEANUP_INTERVAL_MS=3600000
# WebSocket 会话设备与固定摄像头权限刷新周期（毫秒）。
bigscreen-bff BIGSCREEN_WS_AUTHORIZATION_MAX_STALENESS_MS=30000
bigscreen-bff FIXED_CAMERA_CATALOG_LEASE_ENABLED=true
bigscreen-bff FIXED_CAMERA_CATALOG_LEASE_SECONDS=180
# Management 任务聚合专用连接/读取超时与单实例并发上限。
bigscreen-bff PANORAMA_TASK_CONNECT_TIMEOUT_MS=1000
bigscreen-bff PANORAMA_TASK_READ_TIMEOUT_MS=1500
bigscreen-bff PANORAMA_TASK_MAX_CONCURRENCY=8
# Management 通用资源的总并发上限；必须覆盖一个 Overview 的正常并行扇出。
bigscreen-bff PANORAMA_GENERAL_MAX_CONCURRENCY=16
