{
  "components" : {
    "schemas" : {
      "ControlRequestError" : {
        "description" : "Control 参数业务校验失败",
        "properties" : {
          "code" : {
            "description" : "错误码",
            "enum" : [ "INVALID_CONTROL_REQUEST" ],
            "type" : "string"
          },
          "message" : {
            "description" : "错误说明",
            "type" : "string"
          },
          "timestamp" : {
            "description" : "上海时区错误时间",
            "type" : "string"
          }
        },
        "required" : [ "code", "message", "timestamp" ],
        "type" : "object"
      },
      "FileBatchDeleteRequest" : {
        "properties" : {
          "fileIds" : {
            "description" : "文件 ID 数组",
            "items" : {
              "minLength" : 1,
              "type" : "string"
            },
            "maxItems" : 100,
            "minItems" : 0,
            "type" : "array"
          }
        },
        "required" : [ "fileIds" ],
        "type" : "object"
      },
      "FileBatchDeleteResponse" : {
        "properties" : {
          "failed" : {
            "description" : "失败删除数量",
            "format" : "int32",
            "type" : "integer"
          },
          "results" : {
            "description" : "与输入次序对应的逐项结果，允许部分失败",
            "items" : {
              "$ref" : "#/components/schemas/FileDeleteResultResponse"
            },
            "type" : "array"
          },
          "succeeded" : {
            "description" : "成功删除数量",
            "format" : "int32",
            "type" : "integer"
          },
          "total" : {
            "description" : "请求删除的文件数量",
            "format" : "int32",
            "type" : "integer"
          }
        },
        "required" : [ "failed", "results", "succeeded", "total" ],
        "type" : "object"
      },
      "FileBusinessError" : {
        "properties" : {
          "code" : {
            "description" : "业务错误码",
            "type" : "string"
          },
          "details" : {
            "additionalProperties" : { },
            "description" : "可选错误上下文；内容由错误码决定",
            "type" : "object"
          },
          "message" : {
            "description" : "错误说明",
            "type" : "string"
          },
          "path" : {
            "description" : "请求路径",
            "type" : "string"
          },
          "requestId" : {
            "description" : "请求追踪 ID",
            "type" : "string"
          },
          "retryable" : {
            "description" : "是否允许重试",
            "type" : "boolean"
          },
          "status" : {
            "description" : "HTTP 状态码",
            "format" : "int32",
            "type" : "integer"
          },
          "timestamp" : {
            "description" : "上海时区错误时间",
            "type" : "string"
          }
        },
        "required" : [ "code", "message", "path", "requestId", "retryable", "status", "timestamp" ],
        "type" : "object"
      },
      "FileDeleteResultResponse" : {
        "properties" : {
          "code" : {
            "description" : "业务结果码",
            "type" : "string"
          },
          "fileId" : {
            "description" : "文件 ID",
            "type" : "string"
          },
          "message" : {
            "description" : "业务结果说明",
            "type" : "string"
          },
          "success" : {
            "description" : "该项是否删除成功",
            "type" : "boolean"
          }
        },
        "required" : [ "code", "fileId", "message", "success" ],
        "type" : "object"
      },
      "FileDownloadUrlResponse" : {
        "properties" : {
          "downloadUrl" : {
            "description" : "限时下载地址；inline 请求决定展示方式，不记录完整签名地址",
            "type" : "string"
          },
          "expiresAt" : {
            "description" : "本次返回的有效期，上海时区",
            "example" : "2026-09-29 12:00:00",
            "pattern" : "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "type" : "string"
          },
          "fileId" : {
            "description" : "文件 ID",
            "type" : "string"
          }
        },
        "required" : [ "downloadUrl", "expiresAt", "fileId" ],
        "type" : "object"
      },
      "FileListItemResponse" : {
        "properties" : {
          "contentType" : {
            "description" : "文件媒体类型",
            "type" : "string"
          },
          "createdAt" : {
            "description" : "文件创建时间",
            "example" : "2026-09-29 12:00:00",
            "pattern" : "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "type" : "string"
          },
          "deviceId" : {
            "description" : "设备 ID；未关联时为空",
            "type" : [ "string", "null" ]
          },
          "durationSeconds" : {
            "description" : "视频时长，单位秒；未探测时为空",
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "elapsedSeconds" : {
            "description" : "正在处理的视频从开始时间累计的秒数；不适用时为空",
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "endedAt" : {
            "description" : "视频结束时间",
            "example" : "2026-09-29 12:00:00",
            "pattern" : "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "type" : [ "string", "null" ]
          },
          "errorCode" : {
            "description" : "错误码；无错误时为空",
            "type" : [ "string", "null" ]
          },
          "extensionId" : {
            "description" : "通用扩展 ID；未关联时为空",
            "type" : [ "string", "null" ]
          },
          "fileId" : {
            "description" : "文件 ID",
            "type" : "string"
          },
          "fileName" : {
            "description" : "原始文件名",
            "type" : "string"
          },
          "fileSize" : {
            "description" : "文件字节数",
            "format" : "int64",
            "type" : "integer"
          },
          "fileType" : {
            "description" : "文件业务类型",
            "type" : "string"
          },
          "height" : {
            "description" : "画面高度，单位像素；未探测时为空",
            "format" : "int32",
            "type" : [ "integer", "null" ]
          },
          "metadata" : {
            "description" : "扩展元数据的原始 JSON 字符串；未设置时为空",
            "type" : [ "string", "null" ]
          },
          "robotId" : {
            "description" : "机器人 ID；未关联时为空",
            "type" : [ "string", "null" ]
          },
          "startedAt" : {
            "description" : "视频开始时间",
            "example" : "2026-09-29 12:00:00",
            "pattern" : "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "type" : [ "string", "null" ]
          },
          "status" : {
            "description" : "文件处理状态",
            "type" : "string"
          },
          "uploadedAt" : {
            "description" : "上传完成时间；未完成时为空",
            "example" : "2026-09-29 12:00:00",
            "pattern" : "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "type" : [ "string", "null" ]
          },
          "videoStatus" : {
            "description" : "视频处理状态；非视频或未建立处理记录时为空",
            "type" : [ "string", "null" ]
          },
          "width" : {
            "description" : "画面宽度，单位像素；未探测时为空",
            "format" : "int32",
            "type" : [ "integer", "null" ]
          }
        },
        "required" : [ "contentType", "createdAt", "deviceId", "durationSeconds", "elapsedSeconds", "endedAt", "errorCode", "extensionId", "fileId", "fileName", "fileSize", "fileType", "height", "metadata", "robotId", "startedAt", "status", "uploadedAt", "videoStatus", "width" ],
        "type" : "object"
      },
      "FileListResponse" : {
        "properties" : {
          "items" : {
            "description" : "本次返回的文件记录",
            "items" : {
              "$ref" : "#/components/schemas/FileListItemResponse"
            },
            "type" : "array"
          },
          "page" : {
            "description" : "从 0 开始的实际页码",
            "format" : "int32",
            "type" : "integer"
          },
          "size" : {
            "description" : "实际每页数量，范围 1 至 100",
            "format" : "int32",
            "type" : "integer"
          },
          "total" : {
            "description" : "匹配记录总数",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "items", "page", "size", "total" ],
        "type" : "object"
      },
      "FilePlayUrlResponse" : {
        "properties" : {
          "contentType" : {
            "description" : "文件媒体类型",
            "type" : "string"
          },
          "expiresAt" : {
            "description" : "本次返回的有效期，上海时区",
            "example" : "2026-09-29 12:00:00",
            "pattern" : "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "type" : "string"
          },
          "fileId" : {
            "description" : "文件 ID",
            "type" : "string"
          },
          "format" : {
            "description" : "播放格式，当前为 hls",
            "type" : "string"
          },
          "playUrl" : {
            "description" : "带播放 token 的 HLS 地址；Control 会改写为控制侧路径",
            "type" : "string"
          }
        },
        "required" : [ "contentType", "expiresAt", "fileId", "format", "playUrl" ],
        "type" : "object"
      },
      "FrameworkError" : {
        "properties" : {
          "error" : {
            "description" : "HTTP 错误名称",
            "type" : "string"
          },
          "path" : {
            "description" : "请求路径",
            "type" : "string"
          },
          "status" : {
            "description" : "HTTP 状态码",
            "format" : "int32",
            "type" : "integer"
          },
          "timestamp" : {
            "description" : "错误时间",
            "type" : "string"
          }
        },
        "required" : [ "error", "path", "status", "timestamp" ],
        "type" : "object"
      },
      "UploadForm" : {
        "properties" : {
          "deviceId" : {
            "description" : "关联设备 ID",
            "type" : "string"
          },
          "extensionId" : {
            "description" : "通用扩展 ID",
            "type" : "string"
          },
          "file" : {
            "description" : "文件正文",
            "format" : "binary",
            "type" : "string"
          },
          "fileType" : {
            "description" : "文件类型",
            "enum" : [ "VIDEO", "AUDIO", "IMAGE", "LOG", "CONFIG", "MAP", "DOCUMENT", "OTHER" ],
            "type" : "string"
          },
          "metadata" : {
            "description" : "扩展元数据 JSON 字符串；source 区分手动媒体所有权规则",
            "type" : "string"
          },
          "robotId" : {
            "description" : "关联机器人 ID",
            "type" : "string"
          },
          "sourceFileId" : {
            "description" : "来源文件标识",
            "type" : "string"
          }
        },
        "required" : [ "file", "fileType" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "PlaybackToken" : {
        "description" : "文件播放签名；不要求用户身份头",
        "in" : "query",
        "name" : "token",
        "type" : "apiKey"
      },
      "TrustedRoles" : {
        "description" : "由可信 BFF 注入的角色，默认不能为空，逗号分隔",
        "in" : "header",
        "name" : "X-Roles",
        "type" : "apiKey"
      },
      "TrustedUser" : {
        "description" : "由可信 BFF 注入，默认不能为空；不是独立签名凭据",
        "in" : "header",
        "name" : "X-User-Id",
        "type" : "apiKey"
      }
    }
  },
  "info" : {
    "description" : "除 HLS 播放 token 入口外，默认要求受信任的 X-User-Id 和 X-Roles；仅开发配置允许身份回退。浏览器由 BFF 验证 JWT 后注入身份，Control 不独立验签。成功 DTO 与 Media 共享，业务错误正文及状态透传；错误响应头不保证透传。",
    "title" : "Control 文件代理接口",
    "version" : "1.0.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/control/files" : {
      "get" : {
        "description" : "按租户及手动媒体所有者过滤；page 从 0 开始，负数归一为 0；size 限制在 1 至 100。source 过滤 metadata.source。",
        "operationId" : "controlListFiles",
        "parameters" : [ {
          "description" : "机器人 ID；分片请求头用于归属校验，列表/上传表单为可选关联",
          "in" : "query",
          "name" : "robotId",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "设备 ID",
          "in" : "query",
          "name" : "deviceId",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "通用扩展 ID",
          "in" : "query",
          "name" : "extensionId",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "文件类型",
          "in" : "query",
          "name" : "fileType",
          "required" : false,
          "schema" : {
            "enum" : [ "VIDEO", "AUDIO", "IMAGE", "LOG", "CONFIG", "MAP", "DOCUMENT", "OTHER" ],
            "type" : "string"
          }
        }, {
          "description" : "文件处理状态",
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "enum" : [ "UPLOADING", "PROCESSING", "READY", "FAILED", "DELETED" ],
            "type" : "string"
          }
        }, {
          "description" : "按 metadata.source 过滤",
          "in" : "query",
          "name" : "source",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "从 0 开始，负数归一为 0",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "type" : "integer"
          }
        }, {
          "description" : "每页条数，归一到 1 至 100",
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "type" : "integer"
          }
        }, {
          "description" : "由可信 BFF 注入的组织 ID；缺省使用 control.auth.default-org-id",
          "in" : "header",
          "name" : "X-Org-Id",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "终端标识，缺省为 web",
          "in" : "header",
          "name" : "X-Client-Id",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FileListResponse"
                }
              }
            },
            "description" : "处理成功；状态、空值和部分失败以响应字段为准"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "oneOf" : [ {
                    "$ref" : "#/components/schemas/FileBusinessError"
                  }, {
                    "$ref" : "#/components/schemas/FrameworkError"
                  }, {
                    "$ref" : "#/components/schemas/ControlRequestError"
                  } ]
                }
              }
            },
            "description" : "请求校验或绑定失败"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FrameworkError"
                }
              }
            },
            "description" : "未处理的服务错误"
          }
        },
        "security" : [ {
          "TrustedRoles" : [ ],
          "TrustedUser" : [ ]
        } ],
        "summary" : "分页查询文件",
        "tags" : [ "files" ]
      },
      "post" : {
        "description" : "使用 multipart/form-data。大小限制由配置决定；视频上传后进入 PROCESSING。用户手动媒体按角色和所有者校验。",
        "operationId" : "controlUploadFile",
        "parameters" : [ {
          "description" : "由可信 BFF 注入的组织 ID；缺省使用 control.auth.default-org-id",
          "in" : "header",
          "name" : "X-Org-Id",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "终端标识，缺省为 web",
          "in" : "header",
          "name" : "X-Client-Id",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "$ref" : "#/components/schemas/UploadForm"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FileListItemResponse"
                }
              }
            },
            "description" : "处理成功；状态、空值和部分失败以响应字段为准"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "oneOf" : [ {
                    "$ref" : "#/components/schemas/FileBusinessError"
                  }, {
                    "$ref" : "#/components/schemas/FrameworkError"
                  }, {
                    "$ref" : "#/components/schemas/ControlRequestError"
                  } ]
                }
              }
            },
            "description" : "请求校验或绑定失败"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "oneOf" : [ {
                    "$ref" : "#/components/schemas/FileBusinessError"
                  }, {
                    "$ref" : "#/components/schemas/FrameworkError"
                  }, {
                    "$ref" : "#/components/schemas/ControlRequestError"
                  } ]
                }
              }
            },
            "description" : "权限或受控来源网络拒绝"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "oneOf" : [ {
                    "$ref" : "#/components/schemas/FileBusinessError"
                  }, {
                    "$ref" : "#/components/schemas/FrameworkError"
                  }, {
                    "$ref" : "#/components/schemas/ControlRequestError"
                  } ]
                }
              }
            },
            "description" : "当前文件或上传状态不允许操作"
          },
          "413" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "oneOf" : [ {
                    "$ref" : "#/components/schemas/FileBusinessError"
                  }, {
                    "$ref" : "#/components/schemas/FrameworkError"
                  }, {
                    "$ref" : "#/components/schemas/ControlRequestError"
                  } ]
                }
              }
            },
            "description" : "文件或代理正文超过限制"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FrameworkError"
                }
              }
            },
            "description" : "未处理的服务错误"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "oneOf" : [ {
                    "$ref" : "#/components/schemas/FileBusinessError"
                  }, {
                    "$ref" : "#/components/schemas/FrameworkError"
                  }, {
                    "$ref" : "#/components/schemas/ControlRequestError"
                  } ]
                }
              }
            },
            "description" : "存储或内部凭证配置不可用"
          }
        },
        "security" : [ {
          "TrustedRoles" : [ ],
          "TrustedUser" : [ ]
        } ],
        "summary" : "上传简单文件",
        "tags" : [ "files" ]
      }
    },
    "/api/control/files/batch" : {
      "delete" : {
        "description" : "一次最多 100 个非空 ID；HTTP 200 中逐条给出成功或失败，允许部分成功。",
        "operationId" : "controlDeleteFiles",
        "parameters" : [ {
          "description" : "由可信 BFF 注入的组织 ID；缺省使用 control.auth.default-org-id",
          "in" : "header",
          "name" : "X-Org-Id",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "终端标识，缺省为 web",
          "in" : "header",
          "name" : "X-Client-Id",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/FileBatchDeleteRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FileBatchDeleteResponse"
                }
              }
            },
            "description" : "处理成功；状态、空值和部分失败以响应字段为准"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "oneOf" : [ {
                    "$ref" : "#/components/schemas/FileBusinessError"
                  }, {
                    "$ref" : "#/components/schemas/FrameworkError"
                  }, {
                    "$ref" : "#/components/schemas/ControlRequestError"
                  } ]
                }
