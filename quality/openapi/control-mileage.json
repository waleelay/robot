{
  "components" : {
    "schemas" : {
      "ControlRequestError" : {
        "description" : "Control 参数业务校验失败",
        "properties" : {
          "code" : {
            "description" : "错误码",
            "enum" : [ "INVALID_CONTROL_REQUEST" ],
            "type" : "string"
          },
          "message" : {
            "description" : "错误说明",
            "type" : "string"
          },
          "timestamp" : {
            "description" : "上海时区错误时间",
            "type" : "string"
          }
        },
        "required" : [ "code", "message", "timestamp" ],
        "type" : "object"
      },
      "HttpRequestError" : {
        "description" : "Spring Boot 默认 JSON 错误响应；附加字段由部署配置控制",
        "properties" : {
          "error" : {
            "description" : "HTTP 错误名称",
            "type" : "string"
          },
          "path" : {
            "description" : "请求路径",
            "type" : "string"
          },
          "status" : {
            "description" : "HTTP 状态码",
            "format" : "int32",
            "type" : "integer"
          },
          "timestamp" : {
            "description" : "错误时间",
            "type" : "string"
          }
        },
        "required" : [ "error", "path", "status", "timestamp" ],
        "type" : "object"
      },
      "MileageSummaryResponse" : {
        "description" : "持久化分钟桶的里程汇总；不包含质量评级字段",
        "properties" : {
          "byRobot" : {
            "description" : "指定机器人时保留去重后的请求顺序；未指定时按机器人标识排序",
            "items" : {
              "$ref" : "#/components/schemas/RobotMileageSummary"
            },
            "type" : "array"
          },
          "endTime" : {
            "description" : "区间终点，Asia/Shanghai",
            "example" : "2026-08-14 23:59:59",
            "pattern" : "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "type" : "string"
          },
          "hasData" : {
            "description" : "是否存在有效里程样本",
            "type" : "boolean"
          },
          "sampleCount" : {
            "description" : "有效样本总数",
            "format" : "int64",
            "minimum" : 0,
            "type" : "integer"
          },
          "startTime" : {
            "description" : "区间起点，Asia/Shanghai",
            "example" : "2026-08-14 00:00:00",
            "pattern" : "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "type" : "string"
          },
          "timezone" : {
            "description" : "统计时区",
            "enum" : [ "Asia/Shanghai" ],
            "type" : "string"
          },
          "totalMeters" : {
            "description" : "总里程（米）；无样本为 null，有样本且未移动为 0",
            "example" : 1256.8,
            "type" : [ "number", "null" ]
          },
          "unit" : {
            "description" : "计量单位",
            "enum" : [ "m" ],
            "type" : "string"
          }
        },
        "required" : [ "byRobot", "endTime", "hasData", "sampleCount", "startTime", "timezone", "totalMeters", "unit" ],
        "type" : "object"
      },
      "RobotMileageSummary" : {
        "description" : "单个机器人的有效里程",
        "properties" : {
          "hasData" : {
            "description" : "是否存在有效样本",
            "type" : "boolean"
          },
          "mileageMeters" : {
            "description" : "里程（米）；无有效样本为 null",
            "type" : [ "number", "null" ]
          },
          "robotId" : {
            "description" : "机器人标识",
            "example" : "robot-001",
            "type" : "string"
          },
          "sampleCount" : {
            "description" : "有效样本数",
            "format" : "int64",
            "minimum" : 0,
            "type" : "integer"
          }
        },
        "required" : [ "hasData", "mileageMeters", "robotId", "sampleCount" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "仅覆盖里程统计查询。Control 此方法不独立验签或解析用户身份；仅允许受控内网调用。浏览器访问 BFF 时由 BFF 验证 JWT。",
    "title" : "Control 里程统计查询",
    "version" : "1.0.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/control/statistics/mileage" : {
      "get" : {
        "description" : "按分钟桶统计，区间首尾均包含。时间采用 Asia/Shanghai，接受本地展示格式和 ISO 本地时间。未指定或过滤后为空的 robotIds 查询全部机器人；空白项移除，重复项去重。此方法不校验用户身份，需由网络边界和 BFF 控制访问；无有效样本返回 null，不补零。",
        "operationId" : "queryMileageSummary",
        "parameters" : [ {
          "description" : "区间起点，上海时区；兼容 ISO 本地时间如 2026-08-14T00:00:00",
          "in" : "query",
          "name" : "startTime",
          "required" : true,
          "schema" : {
            "example" : "2026-08-14 00:00:00",
            "type" : "string"
          }
        }, {
          "description" : "区间终点，上海时区；不得早于起点",
          "in" : "query",
          "name" : "endTime",
          "required" : true,
          "schema" : {
            "example" : "2026-08-14 23:59:59",
            "type" : "string"
          }
        }, {
          "description" : "机器人列表；支持重复查询参数及单个逗号分隔值；不传或仅空白值时查询全部",
          "in" : "query",
          "name" : "robotIds",
          "required" : false,
          "schema" : {
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MileageSummaryResponse"
                }
              }
            },
            "description" : "查询成功，包括没有有效样本的情况"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "oneOf" : [ {
                    "$ref" : "#/components/schemas/ControlRequestError"
                  }, {
                    "$ref" : "#/components/schemas/HttpRequestError"
                  } ]
                }
              }
            },
            "description" : "缺少时间参数、转换失败，或结束时间早于开始时间"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/HttpRequestError"
                }
              }
            },
            "description" : "未处理的存储或服务错误"
          }
        },
        "summary" : "查询区间有效里程",
        "tags" : [ "里程统计" ]
      }
    }
  },
  "security" : [ ],
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "description" : "供 BFF 调用的受控内网查询",
    "name" : "里程统计"
  } ]
}
